# Build output
/target

# CTF workspace runtime output (.ctf/README.md stays tracked)
.ctf/flags.log
.ctf/errors.log
.ctf/artifacts/
.ctf/reports/
.ctf/solvers/

# Crash reports written when HOME is unset (normally ~/.wrosecode/crash)
.wrosecode-crash/

# Skill corpus: only the SKILL.md files referenced by src/skills.rs via
# include_str! are tracked (a fresh clone must still compile). Everything
# else in skills/ is a local reference library.
skills/*
